# Примеры: замените токен, ID и адрес сервера своими значениями.
# Токен Discord-бота.
DISCORD_TOKEN="your_discord_bot_token"

# ID каналов Discord для статуса и уведомлений, через запятую.
CHANNEL_IDS="345678901234567890,456789012345678901"

# IP-адрес или домен игрового сервера (без протокола и порта).
HOST="192.0.2.10"
# Порт запросов игрового сервера.
PORT="27015"
# Таймаут запроса в миллисекундах: 10000 = 10 секунд.
SERVER_QUERY_TIMEOUT_MS="10000"

# ID ролей Discord с доступом к /server close и /server open, через запятую.
# Пустое значение запрещает изменение статуса через команды.
EVENT_MANAGER_ROLE_IDS="123456789012345678,234567890123456789"

# Короткое имя сервера в названии канала, например: server_name.
SERVER_DISPLAY_NAME="server_name"
