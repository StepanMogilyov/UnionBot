# Примеры: замените токен, ID и адрес сервера своими значениями.
# Токен Discord-бота.
DISCORD_TOKEN="your_discord_bot_token"

# ID каналов Discord для статуса и уведомлений, через запятую.
CHANNEL_IDS="345678901234567890,456789012345678901"

# IP-адрес или домен игрового сервера (без протокола и порта).
HOST="192.0.2.10"
# Порт запросов игрового сервера.
PORT="27015"
# Таймаут запроса в миллисекундах: 10000 = 10 секунд.
SERVER_QUERY_TIMEOUT_MS="10000"

# ID ролей Discord с доступом к /union close, /union open, /union restart, /union set map, /union set lts и /union set duelyard, через запятую.
# Пустое значение запрещает управление сервером через команды.
# /union show maps доступна всем участникам сервера независимо от этого списка.
EVENT_MANAGER_ROLE_IDS="123456789012345678,234567890123456789"

# Токен API Nitrado с правом ROLE_WEBINTERFACE_GENERAL_CONTROL.
# Для подкоманд /union set также нужны ROLE_WEBINTERFACE_SETTINGS_READ и ROLE_WEBINTERFACE_SETTINGS_WRITE.
# Оставьте пустым, чтобы отключить /union restart и все подкоманды /union set.
NITRADO_API_TOKEN=""
# Числовой ID услуги Nitrado (service_id), не IP/порт и не ID пользователя.
NITRADO_SERVICE_ID=""

# Короткое имя сервера в названии канала и slash-командах: Union → /union.
# Для команд используется нижний регистр; 1–32 символа: буквы, цифры, _ или -, без пробелов.
# Если имя пустое, команды используют /server.
SERVER_DISPLAY_NAME="union"
